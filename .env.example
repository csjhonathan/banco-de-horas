# ------------------------------------------------------------------
# Copie para .env  ->  cp .env.example .env
# (o Next carrega .env / .env.local automaticamente)
# ------------------------------------------------------------------

# MongoDB. Local (docker compose up -d mongo) ou Atlas (mongodb+srv://...).
MONGO_URI=mongodb://127.0.0.1:27017/banco_de_horas

# Segredo do Auth.js (assina a sessão JWT). GERE UM:
#   npx auth secret        (ou: openssl rand -base64 32)
# Sem isso o login não funciona.
AUTH_SECRET=

# ---- opcionais (têm padrão, só mexa se precisar) ----
# Fuso para agrupar as horas do Clockify por dia:
# DEFAULT_TZ=America/Sao_Paulo
# Fechar o cadastro depois de criar sua conta:
# ALLOW_REGISTER=false
# Nome do banco/coleção no Mongo:
# MONGO_DB=banco_de_horas
# MONGO_COLLECTION=usuarios

# URL pública do app (webhook do Clockify). Na Vercel é deduzida do request;
# só preencha se a detecção falhar (ex.: atrás de proxy em dev com ngrok):
# WEBHOOK_URL=https://xxxx.ngrok-free.app

# Fallback global de signing secret do webhook (normalmente NÃO precisa —
# cada usuário cadastra as dele pela tela). Aceita lista separada por vírgula:
# CLOCKIFY_WEBHOOK_SECRET=

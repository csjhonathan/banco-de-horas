# ------------------------------------------------------------------
# Copie para .env  ->  cp .env.example .env
# ------------------------------------------------------------------

# Porta do HOST (o app sempre escuta 3000 dentro do container).
# Mude se a 3000 estiver ocupada por outro projeto.
APP_PORT=3000

# MongoDB. Deixe assim para usar o Mongo local do docker-compose,
# ou cole a connection string do Atlas (mongodb+srv://...).
MONGO_URI=mongodb://mongo:27017/banco_de_horas

# Segredo para assinar os cookies de sessao. GERE UM:
#   openssl rand -hex 32
# (se ficar vazio, as sessoes caem toda vez que o app reinicia)
SESSION_SECRET=

# ---- opcionais (tem padrao, so mexa se precisar) ----
# Fuso para agrupar as horas do Clockify por dia:
# DEFAULT_TZ=America/Sao_Paulo
# Fechar o cadastro depois de criar sua conta:
# ALLOW_REGISTER=false
# URL publica do app (webhook do Clockify). Se vazio, e deduzida do request.
# So preencha se a deteccao falhar (ex.: atras de proxy). Em local com ngrok
# a tela ja mostra a URL certa, entao normalmente NAO precisa mexer aqui:
# WEBHOOK_URL=https://xxxx.ngrok-free.app

# Front hospedado em OUTRO dominio (ex.: GitHub Pages)?
# API_URL: base da API que o front vai chamar (injetada em /config.js).
#   Deixe vazio quando o front e servido pelo proprio backend (mesma origem).
# API_URL=https://seu-backend.onrender.com
# CORS_ORIGIN: origem(ns) do front autorizadas a chamar a API (separadas por virgula).
# CORS_ORIGIN=https://csjhonathan.github.io
